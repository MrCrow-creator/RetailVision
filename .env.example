# Runtime
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_HEALTH_TIMEOUT_MS=2000
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_RELOAD=true

# Future providers: put actual keys only in .env
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
POSTGRES_URL=postgresql://retailvision:change_me@localhost:5432/retailvision
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Milestone 2: bounded official export, cached locally; no provider API keys needed
OFF_TARGET_PRODUCTS=3000
OFF_MAX_RAW_RECORDS=12000
OFF_SOURCE_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
OFF_SOURCE_FORMAT=jsonl
OFF_SOURCE_FILE=
OFF_SOURCE_RETRIEVED_AT=
OFF_SNAPSHOT=initial
OFF_MAX_SOURCE_BYTES=134217728
OFF_DOWNLOAD_IMAGES=true
OFF_IMAGE_TIMEOUT=20
OFF_MAX_RETRIES=2
OFF_IMAGE_WORKERS=4
OFF_IMAGE_REQUESTS_PER_SECOND=4
OFF_MAX_IMAGE_BYTES=5242880
# Replace the contact text with your project contact if desired; never put secrets here.
OFF_USER_AGENT=RetailVision/0.2 (academic Product Master ingestion)
